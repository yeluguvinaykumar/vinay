# ---- VINAY configuration ----
# Copy this file to `.env` and fill in real values.

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/vinay"

# Auth — JWT signing secret (use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# Session cookie
COOKIE_NAME="vinay_token"

# Admin (welcome e-mail used by the seed script)
ADMIN_EMAIL="admin@vinay.com"
ADMIN_PASSWORD="Admin@123"

# Site URL (canonical)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="VINAY"

# Map provider (Google Maps embed works without an API key)
NEXT_PUBLIC_MAPS_KEY=""
# Leaflet tile URL (only used by the optional Leaflet map)
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"

# Optional e-mail (nodemailer / SMTP) — leave blank to log e-mails to console
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="VINAY <no-reply@vinay.com>"

# Optional S3/cloud storage for uploads. When empty, uploads are stored on disk
# under /public/uploads (not persistent on serverless platforms).
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""

# Vercel analytics / flags
NEXT_PUBLIC_ANALYTICS_ID=""